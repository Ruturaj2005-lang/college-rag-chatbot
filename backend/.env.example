# ==========================================
# MongoDB Atlas Database Configuration
# ==========================================
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local fallback: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=college_rag_db
VECTOR_INDEX_NAME=vector_index

# ==========================================
# Authentication / Security
# ==========================================
JWT_SECRET_KEY=super-secret-jwt-key-for-college-rag-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==========================================
# AI Provider Configuration
# ==========================================
# Set to 'mock' for offline deterministic development without API costs
# Set to 'openai' for production OpenAI API
AI_PROVIDER=mock

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# RAG Hyperparameters (Specification Defined)
# ==========================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.70

# ==========================================
# File Upload Limits
# ==========================================
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads
